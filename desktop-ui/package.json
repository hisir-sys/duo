{
  "name": "duoai-studio-desktop-ui",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dev:linux": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron --no-sandbox .\""
  },
  "dependencies": {
    "@fontsource/inter": "5.2.6",
    "@fontsource/jetbrains-mono": "5.2.6",
    "lucide-react": "0.554.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "electron": "39.2.7",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "wait-on": "8.0.4"
  }
}
